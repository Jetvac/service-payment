NODE_ENV=production
PORT=4077
APP_SERVICE_NAME=service-payment
APP_DATA_DIR=/opt/service-payment/data
APP_DATABASE_PATH=/opt/service-payment/data/service-payment.sqlite
PUBLIC_BASE_URL=https://pay.example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
MAX_UPLOAD_MB=50
MAX_BACKUP_MB=2048

# Optional TimescaleDB acceleration. SQLite still keeps measurements for full backup/export.
# TIMESCALE_DATABASE_URL=postgresql://user:password@127.0.0.1:29432/service_payment
